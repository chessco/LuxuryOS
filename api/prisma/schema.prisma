generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now())
  users         User[]
  clients       Client[]
  orders        Order[]
  conversations Conversation[]
  queueTickets  QueueTicket[]
  queueRecommendations QueueRecommendation[]
  notificationLogs     NotificationLog[]
}

enum Role {
  SYSTEM_ADMIN
  TENANT_ADMIN
  TENANT_USER
  VENDEDOR
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(TENANT_USER)
  createdAt    DateTime @default(now())
  
  // Real-time Chat relations
  conversations Conversation[] @relation("UserConversations")
  messages      Message[]
}

model Conversation {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  users     User[]    @relation("UserConversations")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
}

model Client {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

enum OrderStage {
  INTERES_LEAD
  COTIZACION_ENVIADA
  APROBADO_ANTICIPO
  EN_PRODUCCION
  CONTROL_CALIDAD
  LISTO_ENTREGA
  ENTREGADO_POSTVENTA
}

enum Priority {
  BAJA
  MEDIA
  ALTA
}

enum PaymentStatus {
  PENDIENTE
  PARCIAL
  PAGADO
}

model Order {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  // Existing OrderStage enum kept for backward compatibility during migration
  stage         OrderStage    @default(INTERES_LEAD)
  
  // New Classification Fields
  type          OrderType     @default(STANDARD)
  status        OrderStatus   @default(DRAFT)

  pieceType     String
  
  // Legacy Financial Fields (to be migrated)
  value         Decimal       @db.Decimal(10, 2)
  cost          Decimal       @db.Decimal(10, 2)
  margin        Decimal       @db.Decimal(10, 2)
  
  // New Financial Fields
  totalAmount   Decimal       @db.Decimal(10, 2) @default(0)
  paidAmount    Decimal       @db.Decimal(10, 2) @default(0)
  balance       Decimal       @db.Decimal(10, 2) @default(0)

  dueDate       DateTime?
  
  // New SLA Dates
  promisedAt    DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?

  priority      Priority      @default(MEDIA)
  paymentStatus PaymentStatus @default(PENDIENTE)
  notes         String?       @db.Text
  
  // New Technical Jewelry Fields
  metal         String?
  color         String?
  karats        String?
  weight        String?
  size          String?
  thickness     String?
  itemCode      String?
  laborCost     Decimal?      @db.Decimal(10, 2)
  materialCost  Decimal?      @db.Decimal(10, 2)

  // Polymorphic Data
  specifications Json?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  imageUrl      String?
  payments      Payment[]
  queueTicket   QueueTicket?
}

enum OrderType {
  STANDARD
  REPAIR
  MANUFACTURE
  LAYAWAY
}

enum OrderStatus {
  // Common
  DRAFT
  QUOTE_SENT
  APPROVED
  CANCELLED
  DELIVERED

  // Repair Specific
  RECEIVED
  DIAGNOSIS_PENDING
  WAITING_PARTS
  IN_REPAIR
  REPAIR_COMPLETED

  // Manufacture Specific
  SPEC_PENDING
  MATERIALS_PENDING
  IN_PRODUCTION
  QUALITY_CHECK
  READY_FOR_PICKUP

  // Layaway Specific
  LAYAWAY_OPEN
  LAYAWAY_EXPIRED
}

model Payment {
  id            String      @id @default(uuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id])
  amount        Decimal     @db.Decimal(10, 2)
  method        String
  reference     String?
  recordedBy    String?
  recordedAt    DateTime    @default(now())
}

enum QueueTicketKind {
  REPAIR
  SALE
  PICKUP
}

enum QueueTicketStatus {
  WAITING
  CALLING
  CALLED
  IN_SERVICE
  DONE
  NO_SHOW
  CANCELLED
}

model QueueTicket {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  kind            QueueTicketKind
  status          QueueTicketStatus @default(WAITING)
  code            String            // e.g., R-104
  customerName    String
  customerPhone   String?
  customerEmail   String?
  qrToken         String            @unique // For QR lookup
  sequenceNumber  Int               @default(autoincrement()) @unique // For daily reset or sequence within tenant
  
  orderId         String?           @unique
  order           Order?            @relation(fields: [orderId], references: [id])
  
  recommendations QueueTicketRecommendation[]
  events          QueueEvent[]
  notifications   NotificationLog[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([qrToken])
  @@unique([tenantId, sequenceNumber])
}

model QueueRecommendation {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  kind            QueueTicketKind
  key             String
  label           String
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  
  tickets         QueueTicketRecommendation[]

  @@index([tenantId, kind, isActive])
}

model QueueTicketRecommendation {
  ticketId         String
  ticket           QueueTicket      @relation(fields: [ticketId], references: [id])
  recommendationId String
  recommendation   QueueRecommendation @relation(fields: [recommendationId], references: [id])
  notes            String?          @db.Text

  @@id([ticketId, recommendationId])
}

model QueueEvent {
  id              String            @id @default(uuid())
  ticketId        String
  ticket          QueueTicket       @relation(fields: [ticketId], references: [id])
  fromStatus      QueueTicketStatus?
  toStatus        QueueTicketStatus
  changedBy       String?           // User ID
  createdAt       DateTime          @default(now())
}

model NotificationLog {
  id              String      @id @default(uuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  ticketId        String
  ticket          QueueTicket @relation(fields: [ticketId], references: [id])
  channel         String      // e.g., "WHATSAPP", "EMAIL"
  templateKey     String      // e.g., "YOUR_TURN"
  to              String?
  dedupeKey       String?     @unique // e.g., "ticketId:templateKey"
  providerMessageId String?
  status          String      // e.g., "SENT", "FAILED"
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

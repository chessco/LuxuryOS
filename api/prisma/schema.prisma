generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  createdAt             DateTime               @default(now())
  users                 User[]
  clients               Client[]
  orders                Order[]
  orderNotes            OrderNote[]
  quotes                Quote[]
  conversations         Conversation[]
  queueTickets          QueueTicket[]
  queueRecommendations  QueueRecommendation[]
  notificationLogs      NotificationLog[]
  settings              Setting[]
  commerceProducts      CommerceProduct[]
  commerceSales         CommerceSale[]
  inventoryReservations InventoryReservation[]
  commerceAuditLogs     CommerceAuditLog[]
  suppliers             Supplier[]
  inventoryEntries      InventoryEntry[]
  inventoryMovements    InventoryMovement[]
  creditAccounts        CreditAccount[]
  creditObligations     CreditObligation[]
  creditPayments        CreditPayment[]
  creditLedgerEntries   CreditLedgerEntry[]
}

enum Role {
  SYSTEM_ADMIN
  TENANT_ADMIN
  TENANT_USER
  VENDEDOR
  REVENDEDOR
  JOYERO
  DISENADOR
}

model User {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  email             String   @unique
  // Nombre de usuario para iniciar sesión, independiente del email (nullable: usuarios antiguos no lo tienen)
  username          String?  @unique
  name              String?
  passwordHash      String
  role              Role     @default(TENANT_USER)
  isActive          Boolean  @default(true)
  // Porcentaje aplicado sobre la Mano de Obra Joyero al calcular su pago.
  // Solo se usa para usuarios con rol JOYERO.
  jewelerPercentage Decimal  @default(100) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())

  // Real-time Chat relations
  conversations         Conversation[]         @relation("UserConversations")
  messages              Message[]
  createdOrders         Order[]                @relation("OrderCreatedBy")
  createdQuotes         Quote[]                @relation("QuoteCreatedBy")
  orderNotes            OrderNote[]
  resellerSales         CommerceSale[]         @relation("CommerceSaleReseller")
  commercePayments      CommercePayment[]      @relation("CommercePaymentRecordedBy")
  inventoryReservations InventoryReservation[] @relation("InventoryReservationReseller")
  commerceAuditLogs     CommerceAuditLog[]     @relation("CommerceAuditLogActor")
  createdInventoryEntries InventoryEntry[]      @relation("InventoryEntryCreatedBy")
  inventoryMovements    InventoryMovement[]     @relation("InventoryMovementCreatedBy")
  creditAccount            CreditAccount?         @relation("CreditAccountReseller")
  createdCreditObligations CreditObligation[]     @relation("CreditObligationCreatedBy")
  recordedCreditPayments   CreditPayment[]        @relation("CreditPaymentRecordedBy")
  creditLedgerEntries      CreditLedgerEntry[]    @relation("CreditLedgerActor")
  clientProfile            Client?                @relation("ClientResellerUser")
}

model Conversation {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  users     User[]    @relation("UserConversations")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
}

enum ClientType {
  RETAIL
  VIP
  RESELLER
}

model Client {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  name           String
  email          String?
  phone          String?
  location       String?
  type           ClientType     @default(RETAIL)
  tags           Json?
  resellerUserId String?        @unique
  resellerUser   User?          @relation("ClientResellerUser", fields: [resellerUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  orders         Order[]
  quotes         Quote[]
  commerceSales  CommerceSale[]
  creditAccount  CreditAccount? @relation("CreditAccountClient")

  @@index([tenantId, type])
}

enum OrderStage {
  INTERES_LEAD
  COTIZACION_ENVIADA
  APROBADO_ANTICIPO
  EN_PRODUCCION
  CONTROL_CALIDAD
  LISTO_ENTREGA
  ENTREGADO_POSTVENTA
}

enum Priority {
  BAJA
  MEDIA
  ALTA
}

enum PaymentStatus {
  PENDIENTE
  PARCIAL
  PAGADO
}

model Order {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id])
  createdById String?
  createdBy   User?      @relation("OrderCreatedBy", fields: [createdById], references: [id])
  // Existing OrderStage enum kept for backward compatibility during migration
  stage       OrderStage @default(INTERES_LEAD)

  // New Classification Fields
  type   OrderType   @default(STANDARD)
  status OrderStatus @default(DRAFT)

  pieceType String

  // Legacy Financial Fields (to be migrated)
  value  Decimal @db.Decimal(10, 2)
  cost   Decimal @db.Decimal(10, 2)
  margin Decimal @db.Decimal(10, 2)

  // New Financial Fields
  totalAmount Decimal @default(0) @db.Decimal(10, 2)
  paidAmount  Decimal @default(0) @db.Decimal(10, 2)
  balance     Decimal @default(0) @db.Decimal(10, 2)

  dueDate DateTime?

  // New SLA Dates
  promisedAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  priority      Priority      @default(MEDIA)
  paymentStatus PaymentStatus @default(PENDIENTE)
  notes         String?       @db.Text

  // New Technical Jewelry Fields
  metal        String?
  color        String?
  karats       String?
  weight       String?
  size         String?
  thickness    String?
  itemCode     String?
  laborCost    Decimal? @db.Decimal(10, 2)
  materialCost Decimal? @db.Decimal(10, 2)

  // Polymorphic Data
  specifications Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imageUrl     String?      @db.LongText
  payments     Payment[]
  queueTicket  QueueTicket?
  sourceQuote  Quote?       @relation("QuoteConversion")
  notesHistory OrderNote[]
  commerceSale CommerceSale? @relation("CommerceSaleOrder")
}

model OrderNote {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([tenantId, createdAt])
}

enum QuoteStatus {
  DRAFT
  SENT
  AUTHORIZED
  CONVERTED
  CANCELLED
}

model Quote {
  id               String      @id @default(uuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  clientId         String
  client           Client      @relation(fields: [clientId], references: [id])
  createdById      String?
  createdBy        User?       @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  status           QuoteStatus @default(DRAFT)
  quoteNumber      Int
  quoteCode        String
  pieceType        String
  notes            String?     @db.Text
  specifications   Json?
  laborCost        Decimal     @default(0) @db.Decimal(10, 2)
  materialCost     Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal     @default(0) @db.Decimal(10, 2)
  validUntil       DateTime?
  sentAt           DateTime?
  authorizedAt     DateTime?
  convertedAt      DateTime?
  cancelledAt      DateTime?
  publicToken      String      @unique
  convertedOrderId String?     @unique
  convertedOrder   Order?      @relation("QuoteConversion", fields: [convertedOrderId], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([tenantId, quoteNumber])
  @@unique([tenantId, quoteCode])
  @@index([tenantId, status, createdAt])
  @@index([clientId])
}

enum OrderType {
  STANDARD
  REPAIR
  MANUFACTURE
  DESIGN
  LASER
  LAYAWAY
  QUOTE
}

enum OrderStatus {
  // Common
  DRAFT
  QUOTE_SENT
  APPROVED
  CANCELLED
  RETURNED
  DELIVERED

  // Repair Specific
  RECEIVED
  DIAGNOSIS_PENDING
  WAITING_PARTS
  IN_REPAIR
  REPAIR_COMPLETED

  // Manufacture Specific
  SPEC_PENDING
  MATERIALS_PENDING
  IN_PRODUCTION
  QUALITY_CHECK
  READY_FOR_PICKUP

  // Layaway Specific
  LAYAWAY_OPEN
  LAYAWAY_EXPIRED
}

model Payment {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  method     String
  reference  String?
  recordedBy String?
  recordedAt DateTime @default(now())
}

enum SalesChannel {
  JEWELRY_INTERNAL
  RESELLER_POS
}

enum CommerceProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CommerceSaleStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

enum CommercePaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model CommerceProduct {
  id                   String                @id @default(uuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  sku                  String
  name                 String
  description          String?               @db.Text
  category             String?
  imageUrl             String?               @db.Text
  unitCost             Decimal?              @db.Decimal(10, 2)
  unitPrice            Decimal               @db.Decimal(10, 2)
  resellerPrice        Decimal?              @db.Decimal(10, 2)
  wholesalePrice       Decimal?              @db.Decimal(10, 2)
  currency             String                @default("MXN") @db.VarChar(3)
  stockOnHand          Int                   @default(0)
  reservedQuantity     Int                   @default(0)
  availableToResellers Boolean               @default(true)
  status               CommerceProductStatus @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  saleItems    CommerceSaleItem[]
  reservations InventoryReservation[]
  inventoryEntryItems InventoryEntryItem[]
  inventoryMovements  InventoryMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId, status, availableToResellers])
}

model CommerceSale {
  id             String                @id @default(uuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  resellerId     String
  reseller       User                  @relation("CommerceSaleReseller", fields: [resellerId], references: [id])
  clientId       String?
  client         Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  linkedOrderId  String?               @unique
  linkedOrder    Order?                @relation("CommerceSaleOrder", fields: [linkedOrderId], references: [id], onDelete: SetNull)
  salesChannel   SalesChannel          @default(RESELLER_POS)
  status         CommerceSaleStatus    @default(DRAFT)
  paymentStatus  CommercePaymentStatus @default(PENDING)
  currency       String                @default("MXN") @db.VarChar(3)
  customerName   String?
  customerPhone  String?
  subtotalAmount Decimal               @default(0) @db.Decimal(10, 2)
  discountAmount Decimal               @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal               @default(0) @db.Decimal(10, 2)
  paidAmount     Decimal               @default(0) @db.Decimal(10, 2)
  creditedAmount Decimal               @default(0) @db.Decimal(10, 2)
  idempotencyKey String?
  notes          String?               @db.Text
  cancellationReason String?           @db.Text
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  items              CommerceSaleItem[]
  payments           CommercePayment[]
  reservations       InventoryReservation[]
  inventoryMovements InventoryMovement[]
  creditObligations  CreditObligation[]

  @@index([tenantId, salesChannel, status])
  @@index([resellerId, createdAt])
  @@index([clientId])
  @@unique([tenantId, salesChannel, resellerId, idempotencyKey], map: "CommerceSale_idempotency_scope_key")
}

model CommerceAuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("CommerceAuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([actorId])
}

model CommerceSaleItem {
  id           String          @id @default(uuid())
  saleId       String
  sale         CommerceSale    @relation(fields: [saleId], references: [id])
  productId    String
  product      CommerceProduct @relation(fields: [productId], references: [id])
  skuSnapshot  String
  nameSnapshot String
  unitPrice    Decimal         @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal         @db.Decimal(10, 2)
  createdAt    DateTime        @default(now())

  @@index([saleId])
  @@index([productId])
}

model CommercePayment {
  id           String                @id @default(uuid())
  saleId       String
  sale         CommerceSale          @relation(fields: [saleId], references: [id])
  amount       Decimal               @db.Decimal(10, 2)
  method       String
  reference    String?
  status       CommercePaymentStatus @default(PENDING)
  idempotencyKey String?
  recordedById String?
  recordedBy   User?                 @relation("CommercePaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt   DateTime              @default(now())

  @@index([saleId])
  @@index([recordedById])
  @@unique([saleId, idempotencyKey], map: "CommercePayment_sale_idempotency_key")
}

model InventoryReservation {
  id         String                     @id @default(uuid())
  tenantId   String
  tenant     Tenant                     @relation(fields: [tenantId], references: [id])
  productId  String
  product    CommerceProduct            @relation(fields: [productId], references: [id])
  resellerId String
  reseller   User                       @relation("InventoryReservationReseller", fields: [resellerId], references: [id])
  saleId     String?
  sale       CommerceSale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)
  quantity   Int
  status     InventoryReservationStatus @default(ACTIVE)
  expiresAt  DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  @@index([tenantId, status, expiresAt])
  @@index([productId, status])
  @@index([resellerId, status])
  @@index([saleId])
}

enum InventoryEntryType {
  INITIAL_STOCK
  ENTRY
}

enum InventoryMovementType {
  INITIAL_STOCK
  ENTRY
  EXIT
  ADJUSTMENT
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryEntries InventoryEntry[]

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
}

model InventoryEntry {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier           @relation(fields: [supplierId], references: [id])
  type         InventoryEntryType
  currency     String             @default("MXN") @db.VarChar(3)
  comments     String?            @db.Text
  totalCost    Decimal            @default(0) @db.Decimal(10, 2)
  createdById  String?
  createdBy    User?              @relation("InventoryEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  items InventoryEntryItem[]
  movements InventoryMovement[]

  @@index([tenantId, type, createdAt])
  @@index([supplierId])
}

model InventoryEntryItem {
  id              String         @id @default(uuid())
  entryId         String
  entry           InventoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  productId       String
  product         CommerceProduct @relation(fields: [productId], references: [id])
  skuSnapshot     String
  nameSnapshot    String
  quantity        Int
  unitCost        Decimal        @db.Decimal(10, 2)
  lineTotal       Decimal        @db.Decimal(10, 2)

  @@index([entryId])
  @@index([productId])
}

model InventoryMovement {
  id            String                @id @default(uuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String
  product       CommerceProduct       @relation(fields: [productId], references: [id])
  entryId       String?
  entry         InventoryEntry?       @relation(fields: [entryId], references: [id], onDelete: SetNull)
  saleId        String?
  sale          CommerceSale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  type          InventoryMovementType
  quantityDelta Int
  balanceAfter  Int?
  unitCost      Decimal?              @db.Decimal(10, 2)
  currency      String                @default("MXN") @db.VarChar(3)
  comments      String?               @db.Text
  createdById   String?
  createdBy     User?                 @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@index([tenantId, productId, createdAt])
  @@index([entryId])
  @@index([saleId])
}

enum QueueTicketKind {
  REPAIR
  SALE
  PICKUP
}

enum QueueTicketStatus {
  WAITING
  CALLING
  CALLED
  IN_SERVICE
  DONE
  NO_SHOW
  CANCELLED
}

model QueueTicket {
  id             String            @id @default(uuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  kind           QueueTicketKind
  status         QueueTicketStatus @default(WAITING)
  code           String // e.g., R-104
  customerName   String
  customerPhone  String?
  customerEmail  String?
  qrToken        String            @unique // For QR lookup
  sequenceNumber Int               @unique @default(autoincrement()) // For daily reset or sequence within tenant

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  recommendations QueueTicketRecommendation[]
  events          QueueEvent[]
  notifications   NotificationLog[]
  settings        Setting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sequenceNumber])
  @@index([tenantId, status])
  @@index([qrToken])
}

model Setting {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  key           String
  value         String       @db.Text
  updatedAt     DateTime     @updatedAt
  QueueTicket   QueueTicket? @relation(fields: [queueTicketId], references: [id])
  queueTicketId String?

  @@unique([tenantId, key])
}

model QueueRecommendation {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  kind      QueueTicketKind
  key       String
  label     String
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)

  tickets QueueTicketRecommendation[]

  @@index([tenantId, kind, isActive])
}

model QueueTicketRecommendation {
  ticketId         String
  ticket           QueueTicket         @relation(fields: [ticketId], references: [id])
  recommendationId String
  recommendation   QueueRecommendation @relation(fields: [recommendationId], references: [id])
  notes            String?             @db.Text

  @@id([ticketId, recommendationId])
}

model QueueEvent {
  id         String             @id @default(uuid())
  ticketId   String
  ticket     QueueTicket        @relation(fields: [ticketId], references: [id])
  fromStatus QueueTicketStatus?
  toStatus   QueueTicketStatus
  changedBy  String? // User ID
  createdAt  DateTime           @default(now())
}

model NotificationLog {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  ticketId          String?
  ticket            QueueTicket? @relation(fields: [ticketId], references: [id])
  channel           String // e.g., "WHATSAPP", "EMAIL"
  templateKey       String // e.g., "YOUR_TURN"
  messageContent    String?      @db.Text
  to                String?
  dedupeKey         String?      @unique // e.g., "ticketId:templateKey"
  providerMessageId String?
  status            String // e.g., "SENT", "FAILED"
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

enum CreditSubjectType {
  RESELLER
  CLIENT
}

enum CreditFacilityType {
  REVOLVING
  NON_REVOLVING
}

enum CreditAccountStatus {
  ACTIVE
  SUSPENDED
}

enum CreditObligationStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum CreditLedgerEntryType {
  LIMIT_UPDATED
  DRAWDOWN
  PAYMENT
  CANCELLED
}

model CreditAccount {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectType     CreditSubjectType
  resellerId      String?             @unique
  reseller        User?               @relation("CreditAccountReseller", fields: [resellerId], references: [id], onDelete: Restrict)
  clientId        String?             @unique
  client          Client?             @relation("CreditAccountClient", fields: [clientId], references: [id], onDelete: Restrict)
  revolvingLimit  Decimal             @default(0) @db.Decimal(12, 2)
  revolvingUsed   Decimal             @default(0) @db.Decimal(12, 2)
  currency        String              @default("MXN") @db.VarChar(3)
  defaultTermDays Int                 @default(30)
  status          CreditAccountStatus @default(ACTIVE)
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  obligations   CreditObligation[]
  ledgerEntries CreditLedgerEntry[]

  @@unique([tenantId, resellerId])
  @@unique([tenantId, clientId])
  @@index([tenantId, subjectType, status])
}

model CreditObligation {
  id              String                 @id @default(uuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId       String
  account         CreditAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  saleId          String?
  sale            CommerceSale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  facilityType    CreditFacilityType
  title           String
  currency        String                 @default("MXN") @db.VarChar(3)
  principalAmount Decimal                @db.Decimal(12, 2)
  paidAmount      Decimal                @default(0) @db.Decimal(12, 2)
  balanceDue      Decimal                @db.Decimal(12, 2)
  termDays        Int                    @default(30)
  issuedAt        DateTime               @default(now())
  dueAt           DateTime
  paidAt          DateTime?
  status          CreditObligationStatus @default(OPEN)
  notes           String?                @db.Text
  idempotencyKey  String?
  createdById     String?
  createdBy       User?                  @relation("CreditObligationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  payments      CreditPayment[]
  ledgerEntries CreditLedgerEntry[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, dueAt])
  @@index([accountId, facilityType, status])
  @@index([saleId])
}

model CreditPayment {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obligationId   String
  obligation     CreditObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  amount         Decimal          @db.Decimal(12, 2)
  method         String
  reference      String?
  notes          String?          @db.Text
  idempotencyKey String?
  recordedById   String?
  recordedBy     User?            @relation("CreditPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt     DateTime         @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([obligationId, recordedAt])
}

model CreditLedgerEntry {
  id                 String                @id @default(uuid())
  tenantId           String
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId          String
  account            CreditAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  obligationId       String?
  obligation         CreditObligation?     @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  actorId            String?
  actor              User?                 @relation("CreditLedgerActor", fields: [actorId], references: [id], onDelete: SetNull)
  type               CreditLedgerEntryType
  facilityType       CreditFacilityType?
  amount             Decimal               @db.Decimal(12, 2)
  balanceAfter       Decimal               @db.Decimal(12, 2)
  revolvingUsedAfter Decimal?              @db.Decimal(12, 2)
  notes              String?               @db.Text
  metadata           Json?
  createdAt          DateTime              @default(now())

  @@index([tenantId, accountId, createdAt])
  @@index([obligationId])
}
